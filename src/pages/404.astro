---
import Base from '../layouts/Base.astro';
import { link } from '../lib/url';
---

<Base title="Page not found" description="This page could not be found.">
  <section class="page-head wrap">
    <h1>Page not found</h1>
    <p>This page isn’t here. It may have been part of the old website, which is being rebuilt.</p>
    <div class="actions">
      <a class="btn solid" href={link('/')}>Home</a>
      <a class="btn" href={link('/works/')}>Works</a>
    </div>
  </section>
</Base>
