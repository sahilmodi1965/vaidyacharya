---
// The biography now lives on the Family page, opened from Pandit Duraiswami Aiyangar's box.
// Old links (and #bibliography) are sent there.
import { link } from '../../lib/url';
const to = link('/descendants/#biography');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <title>Biography</title>
    <script is:inline define:vars={{ to }}>
      location.replace(location.hash === '#bibliography' ? to.replace('#biography', '#bibliography') : to);
    </script>
  </head>
  <body>
    <p>The biography has moved to the <a href={to}>Family page</a>.</p>
  </body>
</html>
