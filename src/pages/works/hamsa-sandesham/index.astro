---
import Base from '../../../layouts/Base.astro';
import content from '../../../data/content.json';
import { hamsaPdf } from '../../../lib/site';
import { link } from '../../../lib/url';

const pdf = link(hamsaPdf.href);
const [first, ...rest] = hamsaPdf.titlePage;
---

<Base title="Hamsa Sandesham (English Translation)" description={`${hamsaPdf.titlePage.slice(1).join(' ')}. English translation by ${hamsaPdf.translator}.`}>
  <section class="page-head wrap">
    <span class="eyebrow"><a href={link('/works/')}>Works</a></span>
    <h1>Hamsa Sandesham <span class="sub">(English Translation)</span></h1>
    <div class="tp">
      <p class="tp-title">{first}</p>
      {rest.map((l) => <p>{l}</p>)}
    </div>
    <p>English translation by {hamsaPdf.translator}. PDF, {hamsaPdf.pages} pages, {hamsaPdf.size}.</p>
    <div class="actions">
      <a class="btn solid" href={pdf} target="_blank" rel="noopener">Open the PDF</a>
      <a class="btn" href={pdf} download>Download PDF</a>
    </div>
  </section>

  <section class="wrap reader">
    <object data={pdf} type="application/pdf" aria-label={content.hamsa.title}>
      <p class="fallback">
        Your browser can’t show the PDF here. <a href={pdf}>Open the Hamsa Sandesham translation (PDF)</a>.
      </p>
    </object>
  </section>
</Base>

<style>
  .sub {
    display: block;
    font-size: 0.5em;
    color: var(--muted);
    margin-top: 0.3em;
  }
  .tp {
    margin: 24px 0;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    max-width: var(--measure);
    text-align: center;
  }
  .tp p {
    margin: 0.2em 0;
    color: var(--ink);
  }
  .tp-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: 0.08em;
  }
  .reader object {
    display: block;
    width: 100%;
    height: min(88vh, 1100px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .fallback {
    padding: 24px;
  }
  @media (max-width: 640px) {
    .reader object {
      height: 70vh;
    }
  }
</style>
