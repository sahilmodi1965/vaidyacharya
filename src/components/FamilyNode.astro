---
// One branch of the family tree: a person (and spouse), then their children, drawn recursively.
// A child's spouse's parents ("in-laws") are drawn beside this couple, at the same level, on the
// side the data gives (`parentsSide`), with a line down to the spouse. Parents of the top row
// itself are drawn by the page, in a row above the tree.
import { link } from '../lib/url';

const { person, root = true } = Astro.props;
const count = (p: any) => p.publications?.length ?? 0;
const inlaws = (person.children ?? [])
  .filter((c: any) => c.spouse?.parents?.length)
  .map((c: any) => ({ child: c.spouse.id, parents: c.spouse.parents, side: c.spouse.parentsSide ?? 'right' }));
const hasInlaws = !root && person.spouse?.parents?.length > 0;
// In-laws on the left: the spouse goes first, so the line down to them doesn't cross the couple's own line.
const pair = [person, person.spouse].filter(Boolean);
if (hasInlaws && person.spouse.parentsSide === 'left') pair.reverse();
---

<li>
  {person.placeholder ? (
    <div class="couple placeholder">
      <span class="who">
        <span class="name">{person.name}</span>
        <span class="role">{person.role}</span>
      </span>
    </div>
  ) : (
    <div class="couple-wrap" data-anchor={hasInlaws ? person.id : undefined}>
      {['left', 'right'].map((side) => {
        const groups = inlaws.filter((g: any) => g.side === side);
        return groups.length > 0 && (
          <div class={`inlaws-row ${side}`}>
            {groups.map((g: any) => (
              <div class="couple inlaws" data-joins={g.child}>
                {g.parents.map((pa: any, i: number) => (
                  <>
                    {i === 1 && <span class="amp" aria-hidden="true">&amp;</span>}
                    <button type="button" class="who spouse" data-person={pa.id} aria-haspopup="dialog">
                      <span class="name">{pa.name}</span>
                      {pa.role && <span class="role">{pa.role}</span>}
                      {pa.patents?.map((pt: any) => (
                        <span class="pubs">{pt.title || `Patent ${pt.number}`} · {pt.filed}</span>
                      ))}
                    </button>
                  </>
                ))}
              </div>
            ))}
          </div>
        );
      })}
      <div class="couple">
        {pair.map((p, i) => (
          <>
            {i === 1 && <span class="amp" aria-hidden="true">&amp;</span>}
            <div class="person">
              <button type="button" class:list={['who', { spouse: p !== person }]} data-person={p.id} aria-haspopup="dialog">
                <span class="name">{p.boxName ?? p.name}</span>
                {p.role && <span class="role">{p.role}</span>}
                {p.publications?.filter((pub: any) => pub.inBox).map((pub: any) => <span class="pubs">{pub.inBox}</span>)}
                {count(p) > 0 && !p.publications.every((pub: any) => pub.inBox) && (
                  <span class="pubs">{count(p)} publication{count(p) === 1 ? '' : 's'}</span>
                )}
                {p.mentions?.filter((m: any) => m.inBox).map((m: any) => <span class="pubs">{m.inBox}</span>)}
              </button>
              {(p.biography || p.bibliography) && (
                <span class="box-links">
                  {p.biography && <a class="bio-link" href={link('/descendants/#biography')} data-panel="biography" aria-haspopup="dialog">Biography</a>}
                  {p.bibliography && <a class="bio-link" href={link('/descendants/#publications')} data-panel="publications" aria-haspopup="dialog">Publications</a>}
                </span>
              )}
            </div>
          </>
        ))}
      </div>
    </div>
  )}
  {person.children?.length > 0 && (
    <ul>
      {person.children.map((c: any) => <Astro.self person={c} root={false} />)}
    </ul>
  )}
</li>
