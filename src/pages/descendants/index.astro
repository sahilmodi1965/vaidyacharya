---
import Base from '../../layouts/Base.astro';
import FamilyNode from '../../components/FamilyNode.astro';
import family from '../../data/descendants.json';
import { link } from '../../lib/url';

// Everyone in the tree (spouses included), for the publication dialogs.
const people: any[] = [];
const walk = (p: any) => {
  if (p.placeholder) return;
  people.push(p);
  if (p.spouse) people.push(p.spouse, ...(p.spouse.parents ?? []));
  p.children?.forEach(walk);
};
walk(family.tree);

// Publications grouped by year, newest first; undated ones last.
const byYear = (pubs: any[]) => {
  const groups = new Map<string, any[]>();
  for (const pub of pubs) {
    const y = pub.year || 'Undated';
    groups.set(y, [...(groups.get(y) ?? []), pub]);
  }
  return [...groups].sort(([a], [b]) => (a === 'Undated' ? 1 : b === 'Undated' ? -1 : b.localeCompare(a)));
};
---

<Base title="Descendants" description={family.intro}>
  <section class="page-head wrap">
    <span class="eyebrow">Family tree</span>
    <h1>{family.heading}</h1>
    <p>{family.intro}</p>
  </section>

  <section class="tree-section">
    <div class="family-tree" tabindex="0" aria-label="Family tree">
      <ul>
        <FamilyNode person={family.tree} />
      </ul>
    </div>
    <p class="wrap scroll-hint">Scroll sideways to see the whole tree.</p>
    <p class="wrap missing">{family.missing}</p>
  </section>

  {people.map((p) => (
    <dialog class="person-dialog" id={`person-${p.id}`} aria-labelledby={`person-${p.id}-name`}>
      <form method="dialog">
        <button class="close" aria-label="Close">×</button>
      </form>
      {p.role && <span class="eyebrow">{p.role}</span>}
      <h2 id={`person-${p.id}-name`}>{p.name}</h2>
      {p.note && <p class="note">{p.note}</p>}
      {!(p.patents?.length > 0 && p.publications.length === 0) && <h3>Publications</h3>}
      {p.patents?.length > 0 && p.publications.length === 0 ? null : p.publications.length > 0 ? (
        <>
          <p class="pub-count">{p.publications.length} publication{p.publications.length === 1 ? '' : 's'}{p.source && ` · ${p.source}`}</p>
          {byYear(p.publications).map(([year, pubs]) => (
            <section class="pub-year">
              <h4>{year}</h4>
              <ul class="pub-list">
                {pubs.map((pub: any) => (
                  <li>
                    {pub.url ? <a href={pub.url} target="_blank" rel="noopener">{pub.title}</a> : <cite>{pub.title}</cite>}
                    {pub.venue && <span class="pub-meta">{pub.venue}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </>
      ) : (
        <p class="empty">No publications listed yet.</p>
      )}
      {p.patents?.length > 0 && (
        <>
          <h3>Patents</h3>
          <ul class="pub-list">
            {p.patents.map((pt: any) => (
              <li>
                <a href={pt.url} target="_blank" rel="noopener">{pt.title || `Indian patent ${pt.number}`}</a>
                <span class="pub-meta">Application {pt.application}, filed {pt.filed} · granted {pt.granted}</span>
              </li>
            ))}
          </ul>
        </>
      )}
      {p.mentions?.length > 0 && (
        <>
          <h3>In the news</h3>
          <ul class="pub-list">
            {p.mentions.map((m: any) => (
              <li>
                <a href={m.url} target="_blank" rel="noopener">{m.title}</a>
                <span class="pub-meta">{[m.venue, m.year].filter(Boolean).join(', ')}</span>
              </li>
            ))}
          </ul>
        </>
      )}
      {p.link && <p class="more"><a href={link(p.link)}>{p.linkLabel ?? 'Read more'}</a></p>}
    </dialog>
  ))}
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-person]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelector<HTMLDialogElement>(`#person-${btn.dataset.person}`)?.showModal();
    });
  });
  // A link like /descendants/#maya opens that person's publications.
  const id = location.hash.slice(1);
  if (id) document.querySelector<HTMLDialogElement>(`#person-${CSS.escape(id)}`)?.showModal();
  // Draw a line from each in-law couple in the top row down to their child in the tree.
  const drawInlawLines = () => {
    const root = document.querySelector<HTMLElement>('.family-tree > ul');
    if (!root) return;
    root.querySelector('.inlaw-lines')?.remove();
    const box = root.getBoundingClientRect();
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.classList.add('inlaw-lines');
    svg.setAttribute('aria-hidden', 'true');
    root.querySelectorAll<HTMLElement>('.inlaws[data-joins]').forEach((from) => {
      const to = root.querySelector<HTMLElement>(`[data-person="${from.dataset.joins}"]`);
      const toCouple = to?.closest<HTMLElement>('.couple');
      if (!to || !toCouple) return;
      const a = from.getBoundingClientRect();
      const b = to.getBoundingClientRect();
      const x1 = a.left + a.width / 2 - box.left;
      const y1 = a.bottom - box.top;
      const x2 = b.left + b.width / 2 - box.left;
      const y2 = toCouple.getBoundingClientRect().top - box.top;
      const mid = y2 - 14;
      const r = Math.min(8, Math.abs(x2 - x1) / 2);
      const dir = Math.sign(x2 - x1) || 1;
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute(
        'd',
        Math.abs(x2 - x1) < 6
          ? `M${x2} ${y1} V${y2}`
          : `M${x1} ${y1} V${mid - r} q0 ${r} ${dir * r} ${r} H${x2 - dir * r} q${dir * r} 0 ${dir * r} ${r} V${y2}`,
      );
      svg.append(path);
    });
    root.append(svg);
  };
  // Where a spouse has their own parents' line coming in, pad one side of the couple so the lines above and below meet the descendant, not the gap between the two.
  const centreOnDescendant = () => {
    document.querySelectorAll<HTMLElement>('.couple-wrap[data-anchor]').forEach((wrap) => {
      wrap.style.marginLeft = wrap.style.marginRight = '';
      const who = wrap.querySelector<HTMLElement>(`[data-person="${wrap.dataset.anchor}"]`);
      if (!who) return;
      const w = wrap.getBoundingClientRect();
      const b = who.getBoundingClientRect();
      const pad = 2 * (b.left + b.width / 2 - w.left) - w.width;
      if (pad > 0) wrap.style.marginRight = `${pad}px`;
      else wrap.style.marginLeft = `${-pad}px`;
    });
  };
  // Every person's box is the same size: as tall as the tallest one.
  const evenHeights = () => {
    const boxes = [...document.querySelectorAll<HTMLElement>('.family-tree .who')];
    boxes.forEach((b) => (b.style.minHeight = ''));
    const tallest = Math.max(...boxes.map((b) => b.getBoundingClientRect().height));
    boxes.forEach((b) => (b.style.minHeight = `${tallest}px`));
  };
  const layout = () => {
    evenHeights();
    centreOnDescendant();
    drawInlawLines();
  };
  layout();
  document.fonts?.ready.then(layout);
  window.addEventListener('resize', layout);

  // Clicking the backdrop closes the dialog.
  document.querySelectorAll<HTMLDialogElement>('.person-dialog').forEach((d) => {
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
  });
</script>

<style>
  .tree-section {
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .scroll-hint {
    display: none;
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .scroll-hint {
      display: block;
    }
  }
  .missing {
    margin-top: 24px;
    font-style: italic;
    color: var(--muted);
  }
</style>

<style is:global>
  /* Top-down family tree. Each <li> draws its own elbow up to the parent's line. */
  .family-tree {
    --join: var(--line);
    overflow-x: auto;
    padding: 8px var(--gutter) 16px;
    border-radius: var(--radius);
  }
  .family-tree ul {
    display: flex;
    justify-content: center;
    margin: 0;
    padding: 28px 0 0;
    position: relative;
  }
  .family-tree > ul {
    position: relative;
    width: max-content;
    margin-inline: auto;
    padding-top: 0;
  }
  .family-tree li {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding: 28px 10px 0;
  }
  .family-tree li::before,
  .family-tree li::after {
    content: '';
    position: absolute;
    top: 0;
    right: 50%;
    width: 50%;
    height: 28px;
    border-top: 2px solid var(--join);
  }
  .family-tree li::after {
    right: auto;
    left: 50%;
    border-left: 2px solid var(--join);
  }
  .family-tree li:first-child::before,
  .family-tree li:last-child::after {
    border: 0 none;
  }
  .family-tree li:last-child::before {
    border-right: 2px solid var(--join);
    border-radius: 0 8px 0 0;
  }
  .family-tree li:first-child::after {
    border-radius: 8px 0 0 0;
  }
  .family-tree ul ul::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    height: 28px;
    border-left: 2px solid var(--join);
  }
  .family-tree > ul > li {
    padding-top: 0;
  }
  /* An only child keeps the same gap as children with siblings, so each generation lines up; the line runs straight down. */
  .family-tree li:only-child::before {
    display: none;
  }
  .family-tree li:only-child::after {
    border-top: 0;
    border-left: 2px solid var(--join);
    border-radius: 0;
  }
  /* The root has no parent line (the in-law line drawn beside it would otherwise stop it being :only-child). */
  .family-tree > ul > li::before,
  .family-tree > ul > li::after {
    display: none;
  }

  /* The root couple stays centred over its children; in-laws hang off its left side. */
  .couple-wrap {
    position: relative;
  }
  .inlaws-row {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 20px;
  }
  .inlaws-row.left {
    right: calc(100% + 48px);
  }
  .inlaws-row.right {
    left: calc(100% + 48px);
  }
  .inlaw-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--join);
    stroke-width: 2;
  }
  .couple {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 10px 24px -20px rgb(42 34 28 / 0.6);
  }
  .couple.placeholder {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }
  /* A spouse's parents: two small cards above them, joined by a bracket line. */
  .parents {
    display: flex;
    justify-content: center;
    gap: 10px;
    position: relative;
    margin-bottom: 26px;
  }
  .parents::before {
    content: '';
    position: absolute;
    left: 25%;
    right: 25%;
    bottom: -14px;
    height: 14px;
    border: 2px solid var(--join, var(--line));
    border-top: 0;
    border-radius: 0 0 8px 8px;
  }
  .parents::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -26px;
    height: 12px;
    border-left: 2px solid var(--line);
  }
  button.who.parent {
    min-width: 0;
    max-width: 9rem;
    flex: 1;
    padding: 8px 8px;
    align-content: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent-2);
    border-radius: 10px;
    box-shadow: 0 10px 24px -20px rgb(42 34 28 / 0.6);
  }
  button.who.parent .name {
    font-size: var(--step--1);
  }
  .person {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .amp {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--accent-2);
  }
  .who {
    display: grid;
    gap: 2px;
    align-content: center;
    width: 11rem;
    padding: 10px 12px;
    font: inherit;
    text-align: center;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-radius: 10px;
  }
  button.who {
    cursor: pointer;
    border-top: 3px solid var(--accent);
  }
  button.who.spouse {
    border-top-color: var(--accent-2);
  }
  button.who:hover,
  button.who:focus-visible {
    background: var(--paper-2);
  }
  button.who:hover .name {
    color: var(--accent);
  }
  .who .name {
    font-family: var(--font-display);
    font-size: var(--step-0);
    line-height: 1.2;
  }
  .who .role {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    line-height: 1.3;
  }
  .who .pubs {
    font-size: 0.75rem;
    color: var(--accent);
  }
  .placeholder .who {
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .family-tree li {
      padding-inline: 4px;
    }
    .who {
      width: 8.5rem;
      padding: 8px 8px;
    }
    .who .name {
      font-size: var(--step--1);
    }
    .who .role {
      font-size: 0.7rem;
    }
  }

  .person-dialog {
    width: min(100% - 32px, 40rem);
    max-height: min(85vh, 40rem);
    padding: 28px;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -30px rgb(42 34 28 / 0.6);
  }
  .person-dialog::backdrop {
    background: rgb(42 34 28 / 0.45);
  }
  .person-dialog h2 {
    font-size: var(--step-2);
    padding-right: 32px;
  }
  .person-dialog h3 {
    font-size: var(--step-0);
    margin-top: 1.4em;
    padding-top: 1em;
    border-top: 1px solid var(--line);
  }
  .person-dialog .note,
  .person-dialog .empty {
    color: var(--muted);
  }
  .person-dialog .close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 36px;
    height: 36px;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }
  .person-dialog .close:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .pub-count {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .pub-year h4 {
    position: sticky;
    top: -28px;
    margin: 1.2em 0 0.4em;
    padding: 4px 0;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--accent);
    background: var(--card);
  }
  .pub-list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    line-height: 1.45;
  }
  .pub-list li {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .pub-list a {
    color: var(--ink);
    text-decoration: none;
  }
  .pub-list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .pub-meta {
    display: block;
    font-style: italic;
    color: var(--muted);
  }
  .more {
    margin: 1em 0 0;
  }
</style>
