---
import Base from '../../layouts/Base.astro';
import content from '../../data/content.json';
import { site } from '../../lib/site';
---

<Base title="Contact" description={`Write to the Vaidyacharya Trust at ${site.email}.`}>
  <section class="page-head wrap">
    <span class="eyebrow">Contact</span>
    <h1>{content.contact.heading}</h1>
  </section>
  <section class="wrap">
    <div class="card">
      <p class="label">Email the {site.name}</p>
      <p class="mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <a class="btn solid" href={`mailto:${site.email}`}>Write to us</a>
    </div>
  </section>
</Base>

<style>
  .card {
    max-width: 560px;
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .label {
    margin-bottom: 0.3em;
    color: var(--muted);
  }
  .mail {
    font-family: var(--font-display);
    font-size: var(--step-2);
    overflow-wrap: anywhere;
  }
  .mail a {
    text-decoration: none;
  }
</style>
