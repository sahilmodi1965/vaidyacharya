---
import { link } from '../lib/url';
import { site, nav } from '../lib/site';
---

<footer class="site-footer">
  <div class="wrap row">
    <p class="copy">© {site.name}</p>
    <ul>
      {nav.map((n) => <li><a href={link(n.href)}>{n.label}</a></li>)}
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 10vw, 120px);
    border-top: 1px solid var(--line);
    background: var(--paper-2);
    font-size: var(--step--1);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 28px;
  }
  .copy {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-0);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--accent);
  }
</style>
