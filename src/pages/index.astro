---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import content from '../data/content.json';
import { site, hamsaPdf } from '../lib/site';
import { img } from '../lib/images';
import { link } from '../lib/url';

const { home, about } = content;
---

<Base title={site.name} description={about.story[0].replace(/<[^>]+>/g, '')}>
  <section class="hero wrap">
    <Image class="portrait" src={img(home.portrait)} alt="Portrait of Pandit Duraiswami Aiyangar" widths={[320, 500]} sizes="(min-width: 860px) 360px, 70vw" loading="eager" />
    <div>
      <h1 class="name">{home.heading}</h1>
      <div class="intro">
        {home.intro.map((p, i) => <p class={i === 0 ? 'lead' : undefined}>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Welcome</h2>
      {home.welcome.map((p) => <p set:html={p} />)}
      <blockquote class="verse">
        {home.verse.map((l) => <p>{l}</p>)}
      </blockquote>
      {home.closing.map((p) => <p set:html={p} />)}
      <p><a href={link('/biography/')}>Read his biography</a> · <a href={link('/about/')}>About the Vaidyacharya Trust</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Works</h2>
      <WorkCard title="Hamsa Sandesham (English Translation)" description={[]}>
        <p>{hamsaPdf.titlePage.slice(1).join(' ')}</p>
        <div class="actions">
          <a class="btn solid" href={link('/works/hamsa-sandesham/')}>Read the translation</a>
        </div>
      </WorkCard>
      {home.books.map((b) => (
        <WorkCard title={b.title} category={b.category} image={b.image} description={b.description} />
      ))}
      <p class="all"><a class="btn solid" href={link('/works/')}>View all works</a></p>
    </div>
  </section>
</Base>

<style>
  /* Home page only: very light blue background (header included). */
  :global(:root) {
    --paper: #eef5fb;
  }
  .hero {
    display: grid;
    gap: 32px 56px;
    padding-block: clamp(40px, 7vw, 88px);
    align-items: center;
  }
  @media (min-width: 860px) {
    .hero {
      grid-template-columns: 360px 1fr;
    }
  }
  .portrait {
    width: min(100%, 360px);
    border-radius: 50% / 42%;
    box-shadow: 0 18px 40px -24px rgb(42 34 28 / 0.5);
  }
  .name {
    text-transform: capitalize;
  }
  .intro {
    max-width: 40rem;
    color: var(--muted);
    line-height: 1.65;
  }
  .intro p {
    margin: 0 0 1em;
  }
  .intro .lead {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--accent);
    padding-bottom: 0.9em;
    border-bottom: 1px solid var(--line);
  }
  .all {
    margin-top: 32px;
  }
</style>
